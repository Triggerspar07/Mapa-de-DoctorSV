document.write('<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"><\/script>');
(function(){
  if (!window.L || typeof L.tileLayer !== 'function') return;

  // Imagen transparente de 1x1 para que una tesela que falle nunca muestre
  // el icono de imagen rota ni el recuadro del navegador.
  const TILE_VACIA = 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';

  // Evita que Leaflet/navegador deje visible el icono de imagen rota.
  if (!document.getElementById('doctor-sv-tile-fix')) {
    const style = document.createElement('style');
    style.id = 'doctor-sv-tile-fix';
    style.textContent = '.leaflet-tile{background:transparent!important;border:0!important;outline:0!important;}';
    document.head.appendChild(style);
  }

  const tileLayerOriginal = L.tileLayer;
  L.tileLayer = function(url, options){
    if (typeof url === 'string' && url.indexOf('basemaps.cartocdn.com/light_all') !== -1) {
      url = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
      options = Object.assign({}, options || {}, {
        subdomains: ['a','b','c'],
        maxZoom: 19,
        maxNativeZoom: 19,
        errorTileUrl: TILE_VACIA,
        attribution: '&copy; OpenStreetMap contributors'
      });
    }

    const capa = tileLayerOriginal.call(this, url, options);

    // Si un servidor de teselas falla, sustituimos inmediatamente la imagen
    // fallida por una imagen transparente. El mapa y los marcadores continúan
    // funcionando y jamás se muestra el cuadro de imagen rota.
    if (capa && typeof capa.on === 'function') {
      capa.on('tileerror', function(e){
        if (e && e.tile) {
          e.tile.src = TILE_VACIA;
          e.tile.alt = '';
          e.tile.style.background = 'transparent';
          e.tile.style.border = '0';
          e.tile.style.outline = '0';
        }
      });
    }

    return capa;
  };
})();
