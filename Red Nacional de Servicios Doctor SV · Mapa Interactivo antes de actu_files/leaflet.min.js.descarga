document.write('<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"><\\/script>');
(function(){
  if (!window.L) return;

  const TILE_VACIA = 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
  const OSM = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';

  // Elimina cualquier icono/borde que el navegador pueda mostrar cuando una
  // imagen de tesela no existe o el servidor de mapas responde con error.
  if (!document.getElementById('doctor-sv-tile-fix')) {
    const style = document.createElement('style');
    style.id = 'doctor-sv-tile-fix';
    style.textContent = [
      '.leaflet-tile{border:0!important;outline:0!important;background:transparent!important;}',
      '.leaflet-tile-container img{border:0!important;outline:0!important;}',
      '.leaflet-tile-broken{display:none!important;visibility:hidden!important;}'
    ].join('');
    document.head.appendChild(style);
  }

  // Captura globalmente los errores de cualquier <img> usado como tesela.
  // Se hace en fase de captura para funcionar incluso si la capa no fue
  // creada por nuestra llamada a L.tileLayer.
  document.addEventListener('error', function(ev){
    const img = ev.target;
    if (img && img.tagName === 'IMG' && img.classList.contains('leaflet-tile')) {
      img.classList.add('leaflet-tile-broken');
      img.src = TILE_VACIA;
      img.alt = '';
      img.removeAttribute('title');
    }
  }, true);

  // Fuerza cualquier TileLayer de mapas a utilizar OSM. Esto evita que una
  // capa antigua de CartoDB siga generando teselas rotas.
  if (L.TileLayer && L.TileLayer.prototype) {
    const originalGetTileUrl = L.TileLayer.prototype.getTileUrl;
    L.TileLayer.prototype.getTileUrl = function(coords){
      const url = String(this._url || '');
      if (/carto|cartocdn|basemaps/i.test(url)) {
        const subdomains = ['a','b','c'];
        const s = subdomains[(coords.x + coords.y) % subdomains.length];
        return OSM.replace('{s}', s)
          .replace('{z}', coords.z)
          .replace('{x}', coords.x)
          .replace('{y}', coords.y);
      }
      return originalGetTileUrl.call(this, coords);
    };
  }

  const tileLayerOriginal = L.tileLayer;
  L.tileLayer = function(url, options){
    if (typeof url === 'string' && /carto|cartocdn|basemaps/i.test(url)) {
      url = OSM;
      options = Object.assign({}, options || {}, {
        subdomains: ['a','b','c'],
        maxZoom: 19,
        maxNativeZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
      });
    }

    const capa = tileLayerOriginal.call(this, url, options);
    if (capa && typeof capa.on === 'function') {
      capa.on('tileerror', function(e){
        if (e && e.tile) {
          e.tile.classList.add('leaflet-tile-broken');
          e.tile.src = TILE_VACIA;
          e.tile.alt = '';
          e.tile.removeAttribute('title');
        }
      });
    }
    return capa;
  };
})();
